# MONIEZI public build-time configuration
#
# The current GitHub Pages deployment uses ONE repository variable, matching
# the stable v38 repository. This is a public Worker URL, not a secret.

VITE_LICENSE_API_BASE=https://moniezi-license-v37.moniezi-vg.workers.dev

# No GitHub repository secrets are required for the MONIEZI front-end build.
# Cloudflare Worker secrets remain configured in Cloudflare, not in this repo.
